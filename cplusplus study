int main() {
    double sales = 95000;
    const double state_tax = 0.04;
    double stateTax = sales *  state_tax;
    const double county_tax = 0.02;
    double                countyTax = sales *  county_tax;

    cout << "Sales: $" << sales << endl
        << "State Tax: $" <<  stateTax << endl
        << "County Tax: $" << countyTax << endl
        << "Tax Return: $" << (sales - stateTax - countyTax) << endl;

    return 0;

}